# https for A.C.O.R.N on its private address. The token (CF_API_TOKEN) comes from /srv/acorn/caddy/cloudflare.env, never from git.
acorn.goliveoak.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	encode gzip
	# The live feed (a WebSocket) and the event stream go straight to the realtime service. They used to go through the web container, which hands a WebSocket upgrade on as a plain request,
	# so the live connection never opened (the Live Feed sat on "Connecting" for good).
	@realtime path /ws /ws/* /sse
	handle @realtime {
		reverse_proxy realtime:4000 {
			flush_interval -1
		}
	}
	handle {
		# Leafy's answers can take minutes; match the web container's own limit.
		reverse_proxy web:3000 {
			transport http {
				response_header_timeout 200s
			}
		}
	}
}

# The public tripwire address (honeytokens). Only the Cloudflare tunnel (the cloudflared service) reaches this port, from inside the docker network; it is not published on the server. It answers the
# tripwire path and nothing else: every other path is a 404, so the internet-facing name never exposes the console or the rest of the API.
:8088 {
	@canary path_regexp canary ^/api/v1/canary/[0-9a-fA-F-]{36}$
	handle @canary {
		reverse_proxy api:8000 {
			# The visitor's address as Cloudflare saw it, so the alert names who opened the file. The API takes the last X-Forwarded-For entry from our own proxy.
			header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
		}
	}
	handle {
		respond "Not found" 404
	}
}
